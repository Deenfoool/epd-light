function PrintPreview({doc}:{doc:DocumentRow}){const t=cargoTotals(doc.data);return <div className="print-sheet"><div className="watermark">ЧЕРНОВИК — НЕ ЯВЛЯЕТСЯ ПЕРЕВОЗОЧНЫМ ДОКУМЕНТОМ</div><h1>Электронная транспортная накладная — ЧЕРНОВИК</h1><div className="print-meta"><b>{doc.doc_number}</b><span>{fmt(doc.doc_date)}</span></div><h3>Участники</h3>{[['Грузоотправитель',doc.data.shipper],['Грузополучатель',doc.data.consignee],['Перевозчик',doc.data.carrier]].map(([n,p]:any)=><div className="print-row" key={n}><b>{n}</b><span>{p.name||'—'} · ИНН {p.inn||'—'} · {p.address||'—'}</span></div>)}<h3>Маршрут</h3><p>{doc.data.route.loadAddress||'—'} → {doc.data.route.unloadAddress||'—'}</p><h3>Груз</h3><table><thead><tr><th>Наименование</th><th>Мест</th><th>Масса, кг</th><th>Упаковка</th></tr></thead><tbody>{doc.data.cargo.map(c=><tr key={c.id}><td>{c.name}</td><td>{c.places}</td><td>{c.weight}</td><td>{c.packaging}</td></tr>)}</tbody></table><p><b>Итого:</b> {t.places} мест, {t.weight} кг</p><h3>Транспорт</h3><p>{doc.data.transport.brand} {doc.data.transport.model}, {doc.data.transport.plate}; водитель: {doc.data.transport.driverName}</p><div className="print-disclaimer">Этот файл — печатное превью черновика. Он не подписан КЭП, не передан оператору ИС ЭПД и не является юридически значимым перевозочным документом.</div></div>}
