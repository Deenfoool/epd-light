function Dashboard({docs}:{docs:DocumentRow[]}){const month=new Date().toISOString().slice(0,7);const current=docs.filter(d=>d.created_at.startsWith(month));return <><div className="page-title"><div><h1>Обзор</h1><p>Черновики ЭТрН и готовность к передаче оператору.</p></div><Button onClick={()=>go('/app/documents/new')}><Plus size={16}/>Новая ЭТрН</Button></div><div className="stats"><Card><span>Черновики за месяц</span><b>{current.length}</b></Card><Card><span>Готовы к передаче</span><b>{docs.filter(d=>d.status==='ready').length}</b></Card><Card><span>Требуют заполнения</span><b>{docs.filter(d=>d.status==='incomplete').length}</b></Card><Card><span>Всего документов</span><b>{docs.length}</b></Card></div><Card><div className="card-head"><h3>Последние документы</h3><Button variant="ghost" onClick={()=>go('/app/documents')}>Все документы <ChevronRight size={16}/></Button></div><DocTable docs={docs.slice(0,5)} onReload={()=>{}}/></Card></>}

function StatusBadge({s}:{s:DocumentRow['status']}){return <Badge tone={s==='ready'?'success':s==='incomplete'?'warn':s==='archived'?'neutral':'info'}>{statusLabel[s]}</Badge>}
