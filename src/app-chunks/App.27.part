  return <><div className="page-title"><div><h1>Импорт</h1><p>Контрагенты и грузовые позиции из CSV. XLSX — в разработке.</p></div></div>{error&&<div className="error-box">{error}</div>}<div className="two-cards"><Card><div className="card-head"><h3>Контрагенты</h3><Button variant="ghost" onClick={()=>sample('companies')}><Download size={15}/>Пример</Button></div><p className="muted">Обязательные колонки: <code>name</code>, <code>inn</code>.</p><input className="file-input" type="file" accept=".csv,text/csv" onChange={e=>e.target.files?.[0]&&readCsv(e.target.files[0],['name','inn'],setRows)}/>{rows.length>0&&<><h3>Предпросмотр: {rows.length}</h3><div className="table-wrap"><table><thead><tr><th>name</th><th>inn</th><th>kpp</th></tr></thead><tbody>{rows.slice(0,15).map((r,i)=><tr key={i}><td>{r.name}</td><td>{r.inn}</td><td>{r.kpp}</td></tr>)}</tbody></table></div><Button onClick={commitCompanies}>Импортировать {rows.length}</Button></>}</Card><Card><div className="card-head"><h3>Грузовые позиции</h3><Button variant="ghost" onClick={()=>sample('cargo')}><Download size={15}/>Пример</Button></div><p className="muted">Обязательные колонки: <code>name</code>, <code>places</code>, <code>weight</code>.</p><input className="file-input" type="file" accept=".csv,text/csv" onChange={e=>e.target.files?.[0]&&readCsv(e.target.files[0],['name','places','weight'],setCargoRows)}/>{cargoRows.length>0&&<><h3>Предпросмотр: {cargoRows.length}</h3><div className="table-wrap"><table><thead><tr><th>name</th><th>places</th><th>weight</th></tr></thead><tbody>{cargoRows.slice(0,15).map((r,i)=><tr key={i}><td>{r.name}</td><td>{r.places}</td><td>{r.weight}</td></tr>)}</tbody></table></div><Button onClick={createCargoDoc}>Создать черновик с грузом</Button></>}</Card></div></>}
