function DirectoryPage<T extends {id:string}>({title,subtitle,items,fields,onSave,onDelete,newItem}:{title:string,subtitle:string,items:T[],fields:{key:keyof T,label:string}[],onSave:(x:T)=>Promise<void>,onDelete:(id:string)=>Promise<void>,newItem:()=>T}){const [edit,setEdit]=useState<T|null>(null);const [q,setQ]=useState('');const shown=items.filter(x=>JSON.stringify(x).toLowerCase().includes(q.toLowerCase()));return <><div className="page-title"><div><h1>{title}</h1><p>{subtitle}</p></div><Button onClick={()=>setEdit(newItem())}><Plus size={16}/>Добавить</Button></div><Card><div className="toolbar"><div className="search"><Search size={16}/><Input value={q} onChange={(e:any)=>setQ(e.target.value)} placeholder="Поиск"/></div></div><div className="table-wrap"><table><thead><tr>{fields.map(f=><th key={String(f.key)}>{f.label}</th>)}<th></th></tr></thead><tbody>{shown.length===0?<tr><td className="empty" colSpan={fields.length+1}>Пока пусто</td></tr>:shown.map(x=><tr key={x.id}>{fields.map(f=><td key={String(f.key)}>{Array.isArray(x[f.key])?(x[f.key] as any[]).join(', '):String(x[f.key]??'')}</td>)}<td><div className="row-actions"><button onClick={()=>setEdit(x)}>Изменить</button><button onClick={async()=>{if(confirm('Удалить запись?')){await onDelete(x.id)}}}><Trash2 size={16}/></button></div></td></tr>)}</tbody></table></div></Card>{edit&&<div className="modal"><Card className="modal-card"><button className="modal-x" onClick={()=>setEdit(null)}><X/></button><h3>{edit.id?'Редактирование':'Новая запись'}</h3>{fields.map(f=><Field label={f.label} key={String(f.key)}><Input value={Array.isArray(edit[f.key])?(edit[f.key] as any[]).join(', '):String(edit[f.key]??'')} onChange={(e:any)=>setEdit({...edit,[f.key]:Array.isArray(edit[f.key])?e.target.value.split(',').map((s:string)=>s.trim()).filter(Boolean):e.target.value})}/></Field>)}<Button className="full" onClick={async()=>{await onSave(edit);setEdit(null)}}>Сохранить</Button></Card></div>}</>}
