
function ImportPage({reloadCompanies,onDocCreated}:{reloadCompanies:()=>void,onDocCreated:(d:DocumentRow)=>void}){const [rows,setRows]=useState<any[]>([]);const [cargoRows,setCargoRows]=useState<any[]>([]);const [error,setError]=useState('');
  const readCsv=(file:File,required:string[],done:(x:any[])=>void)=>{const r=new FileReader();r.onload=()=>{const text=String(r.result||'');const lines=text.split(/\r?\n/).filter(Boolean);if(!lines.length)return;const headers=lines[0].split(';').map(x=>x.trim().toLowerCase());if(!required.every(x=>headers.includes(x))){setError(`Нужны колонки: ${required.join(', ')}. Разделитель — ;`);return}setError('');done(lines.slice(1).map(line=>{const v=line.split(';');const o:any={};headers.forEach((h,i)=>o[h]=v[i]?.trim()||'');return o}))};r.readAsText(file,'utf-8')}
  const sample=(kind:'companies'|'cargo')=>{const content=kind==='companies'?'name;inn;kpp;roles;address;phone;email\nООО «Пример»;7700000000;770001001;грузоотправитель;Москва;+79000000000;demo@example.test':'name;places;unit;weight;value;packaging;conditions\nДемонстрационный груз;10;мест;500;;короб;';const blob=new Blob([content],{type:'text/csv'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=kind==='companies'?'companies-example.csv':'cargo-example.csv';a.click()}
  const commitCompanies=async()=>{for(const r of rows){await saveCompany({id:uid(),name:r.name,inn:r.inn,kpp:r.kpp||'',roles:(r.roles||'').split(',').filter(Boolean),address:r.address||'',phone:r.phone||'',email:r.email||''})}setRows([]);reloadCompanies()}
