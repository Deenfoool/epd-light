function Pricing(){const [modal,setModal]=useState(false);return <PublicShell><section className="section"><div className="container"><h1>Тарифы</h1><p className="lead">14 дней бесплатно. Приём платежей пока не подключён — деньги не списываются.</p><div className="three-grid pricing">{[['Старт','990 ₽','до 50 черновиков',['1 пользователь','Справочники','JSON и печать','CSV-импорт']],['Бизнес','2 490 ₽','до 500 черновиков',['Всё из Старт','Шаблоны','История','Приоритетная поддержка']],['Команда','4 990 ₽','до 2000 черновиков',['До 5 пользователей','Интеграции','1С/API roadmap','Заявка оператору']]].map((p,i)=><Card className={i===1?'featured':''} key={p[0] as string}><h3>{p[0]}</h3><div className="price">{p[1]} <span>/ мес</span></div><p>{p[2]}</p><ul>{(p[3] as string[]).map(x=><li key={x}><Check size={16}/>{x}</li>)}</ul><Button variant={i===1?'primary':'outline'} className="full" onClick={()=>setModal(true)}>Выбрать тариф</Button></Card>)}</div></div></section>{modal&&<div className="modal"><Card><button className="modal-x" onClick={()=>setModal(false)}><X/></button><h3>Приём оплаты подключается</h3><p>Транзакция не создаётся и деньги не списываются. Пока можно зарегистрироваться и пользоваться MVP.</p><Button onClick={()=>{setModal(false);go('/auth?mode=signup')}}>Создать аккаунт</Button></Card></div>}</PublicShell>}

