function Integrations({profile}:{profile:Profile}){const [form,setForm]=useState({company_name:profile.company_name,inn:profile.inn,operator:'Не выбрали',contact:profile.email||profile.phone});const [sent,setSent]=useState(false);const submit=async(e:any)=>{e.preventDefault();await saveIntegrationRequest(form);setSent(true)};return <><div className="page-title"><div><h1>Интеграции</h1><p>Подключения к внешним системам.</p></div></div><div className="three-grid"><Card><h3>Оператор ИС ЭПД</h3><Badge tone="warn">Не подключен</Badge><p>Юридически значимая отправка будет доступна только после подключения аккредитованного оператора.</p></Card><Card><h3>1С</h3><Badge>В разработке</Badge><p>Обмен справочниками и черновиками.</p></Card><Card><h3>API</h3><Badge>В разработке</Badge><p>API для автоматического создания черновиков.</p></Card></div><Card className="top-gap"><h3>Оставить заявку на подключение оператора</h3>{sent?<div className="success-box"><Check/>Заявка сохранена.</div>:<form onSubmit={submit} className="form-grid"><Field label="Компания"><Input value={form.company_name} onChange={(e:any)=>setForm({...form,company_name:e.target.value})}/></Field><Field label="ИНН"><Input value={form.inn} onChange={(e:any)=>setForm({...form,inn:e.target.value})}/></Field><Field label="Какой оператор"><Select value={form.operator} onChange={(e:any)=>setForm({...form,operator:e.target.value})}><option>Не выбрали</option><option>Контур</option><option>Такском</option><option>СБИС / Тензор</option><option>Другой</option></Select></Field><Field label="Контакт"><Input value={form.contact} onChange={(e:any)=>setForm({...form,contact:e.target.value})}/></Field><div><Button type="submit">Отправить заявку</Button></div></form>}</Card></>}
