    } else if(pathname==='/app/companies')content=<DirectoryPage title="Контрагенты" subtitle="Организации и ИП для быстрого заполнения ЭТрН." items={companies} fields={[{key:'name',label:'Название'},{key:'inn',label:'ИНН'},{key:'kpp',label:'КПП'},{key:'roles',label:'Роли/теги'},{key:'address',label:'Адрес'},{key:'phone',label:'Телефон'},{key:'email',label:'Email'}]} newItem={()=>({id:uid(),name:'',inn:'',kpp:'',roles:[],address:'',phone:'',email:''})} onSave={async x=>{await saveCompany(x);await reloadCompanies();flash('Контрагент сохранён')}} onDelete={async id=>{await deleteCompany(id);await reloadCompanies()}}/>
    else if(pathname==='/app/vehicles')content=<DirectoryPage title="Транспорт" subtitle="Автомобили и прицепы." items={vehicles} fields={[{key:'brand',label:'Марка'},{key:'model',label:'Модель'},{key:'plate',label:'Госномер'},{key:'vehicle_type',label:'Тип'},{key:'trailer_plate',label:'Прицеп'}]} newItem={()=>({id:uid(),brand:'',model:'',plate:'',vehicle_type:'',trailer_plate:''})} onSave={async x=>{await saveVehicle(x);await reloadVehicles()}} onDelete={async id=>{await deleteVehicle(id);await reloadVehicles()}}/>
    else if(pathname==='/app/drivers')content=<DirectoryPage title="Водители" subtitle="Справочник водителей." items={drivers} fields={[{key:'full_name',label:'ФИО'},{key:'phone',label:'Телефон'},{key:'license',label:'Удостоверение'}]} newItem={()=>({id:uid(),full_name:'',phone:'',license:''})} onSave={async x=>{await saveDriver(x);await reloadDrivers()}} onDelete={async id=>{await deleteDriver(id);await reloadDrivers()}}/>
