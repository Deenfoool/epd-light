{
  "name": "epd-light",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preflight": "node scripts/preflight-deploy.mjs && node scripts/preflight-runtime.mjs && node scripts/preflight.mjs",
    "deploy:check": "node scripts/check-deployment-env.mjs && node scripts/check-billing-env.mjs",
    "deploy:env:test": "node scripts/test-deployment-env.mjs && node scripts/test-billing-env.mjs",
    "deploy:server-day": "sh deploy/server-day.sh",
    "db:migrate": "sh deploy/apply-migrations.sh",
    "backup:create": "sh deploy/backup-postgres.sh",
    "backup:verify": "sh deploy/verify-postgres-backup.sh",
    "backup:restore:test": "sh deploy/test-restore-postgres.sh",
    "audit:test": "node scripts/test-audit.mjs",
    "auth:test": "node scripts/test-auth.mjs",
    "authorization:test": "node scripts/test-authorization.mjs",
    "repository:test": "node scripts/test-supabase-repository.mjs",
    "attempt-repository:test": "node scripts/test-operator-attempt-repository.mjs",
    "attempt-client:test": "node scripts/test-operator-attempt-client.mjs",
    "idempotency:test": "node scripts/test-idempotency.mjs",
    "billing:test": "node scripts/test-billing-foundation.mjs",
    "billing-payment:test": "node scripts/test-billing-payment-boundary.mjs",
    "billing-env:test": "node scripts/test-billing-env.mjs",
    "web-security:test": "node scripts/test-web-security.mjs",
    "rate-limit:test": "node scripts/test-rate-limit.mjs",
    "gateway:test": "node scripts/test-gateway.mjs",
    "gateway:auth:test": "node scripts/test-gateway-auth.mjs",
    "kontur:provider:test": "node scripts/test-kontur-provider.mjs",
    "kontur:userdata:test": "node scripts/test-kontur-userdata.mjs",
    "kontur:generation:test": "node scripts/test-kontur-generation.mjs",
    "kontur:sandbox:test": "node scripts/test-kontur-sandbox.mjs",
    "kontur:schema:check": "node scripts/check-kontur-schemas.mjs",
    "kontur:schema:save": "node scripts/check-kontur-schemas.mjs --save",
    "fns:schema:check": "node scripts/check-fns-schema.mjs",
    "fns:schema:save": "node scripts/check-fns-schema.mjs --save",
    "predev": "node scripts/assemble-app.mjs",
    "dev": "vite",
    "prebuild": "node scripts/assemble-app.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "jose": "6.2.10",
    "lucide-react": "0.575.0",
    "pg": "8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.8.3",
    "vite": "8.1.5"
  }
}
