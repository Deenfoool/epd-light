# Public frontend configuration. VITE_* values are embedded into browser JavaScript.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Private backend gateway configuration. These defaults keep all external sending disabled.
EPD_OPERATOR_PROVIDER=none
EPD_OPERATOR_MODE=disabled
EPD_MAX_BODY_BYTES=524288
EPD_ALLOWED_ORIGINS=

# Private Kontur/Diadoc server-side placeholders.
# They are NOT required for local UserDataXml preview and do NOT enable /send.
# With sandbox credentials they can be used by server-only utilities such as
# `npm run kontur:schema:check` and the private GenerateTitleXml boundary.
# No public gateway route currently invokes those external calls.
EPD_KONTUR_BOX_ID=
EPD_KONTUR_ACCESS_TOKEN=

# Do NOT put operator API tokens, private keys, KEP material or Supabase service_role
# into VITE_* variables. Provider secrets belong only to the backend secret store/env.
