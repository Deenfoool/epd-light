# Public frontend configuration. VITE_* values are embedded into browser JavaScript.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Private backend gateway configuration.
# Keep `disabled` until you intentionally run a sandbox GenerateTitleXml test.
EPD_OPERATOR_PROVIDER=none
EPD_OPERATOR_MODE=disabled
EPD_MAX_BODY_BYTES=524288
EPD_ALLOWED_ORIGINS=

# Gateway authentication.
# Local/demo Docker may keep `disabled` only while EPD_OPERATOR_MODE=disabled.
# Sandbox operator mode must use `supabase` and asymmetric Supabase JWT signing keys.
EPD_GATEWAY_AUTH_MODE=disabled
EPD_AUTH_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EPD_AUTH_AUDIENCE=authenticated
# Optional: pin a client_id claim when your auth setup uses one.
EPD_AUTH_CLIENT_ID=

# Server-side canonical document repository.
# The gateway sends the verified USER JWT to Supabase Data API, so documents RLS remains authoritative.
# Use the public anon/publishable key here. NEVER use service_role for this path.
EPD_DATA_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EPD_DATA_SUPABASE_PUBLIC_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# In-memory gateway rate limits. They are applied before request bodies are parsed.
EPD_RATE_LIMIT_WINDOW_MS=60000
EPD_RATE_LIMIT_MAX=60
EPD_AUTH_ATTEMPT_LIMIT_MAX=120
# Stricter per-user limit for endpoints that actually call an operator API.
EPD_EXTERNAL_RATE_LIMIT_MAX=10

# Private Kontur/Diadoc server-side sandbox credentials.
# They are not required for local UserDataXml preview and never enable /send.
EPD_KONTUR_BOX_ID=
EPD_KONTUR_ACCESS_TOKEN=

# To intentionally enable ONLY sandbox GenerateTitleXml after all values above are configured:
# EPD_OPERATOR_PROVIDER=kontur
# EPD_OPERATOR_MODE=sandbox
# EPD_GATEWAY_AUTH_MODE=supabase
# The sandbox route accepts only {"documentId":"<uuid>"}; it reloads the canonical document
# through Supabase RLS, calls GenerateTitleXml, and does NOT sign or call PostMessage.

# Do NOT put operator API tokens, private keys, KEP material, Supabase service_role,
# or any other server secret into VITE_* variables. Provider secrets belong only
# to the private backend secret store/env.
