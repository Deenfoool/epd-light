# Public frontend configuration. VITE_* values are embedded into browser JavaScript.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Runtime release/build metadata.
# EPD_RELEASE is public metadata. server-day injects EPD_BUILD_COMMIT and EPD_BUILD_TIME automatically
# from the checked-out git revision/current UTC time and verifies the running container reports them back.
EPD_RELEASE=0.1.0
# Normally leave these unset in .env.production when using deploy/server-day.sh.
# EPD_BUILD_COMMIT=
# EPD_BUILD_TIME=

# Deployment safety mode.
# `local` permits auth-disabled demo development. Any internet-facing production host must use `production`.
# In production the gateway refuses to start unless EPD_GATEWAY_AUTH_MODE=supabase.
EPD_DEPLOYMENT_MODE=local

# Private backend gateway configuration.
# Keep `disabled` until you intentionally run a sandbox GenerateTitleXml test.
EPD_OPERATOR_PROVIDER=none
EPD_OPERATOR_MODE=disabled
EPD_MAX_BODY_BYTES=524288
EPD_ALLOWED_ORIGINS=

# Gateway authentication.
# Local/demo Docker may keep `disabled` only with EPD_DEPLOYMENT_MODE=local and EPD_OPERATOR_MODE=disabled.
# Production and sandbox operator mode must use `supabase` and asymmetric Supabase JWT signing keys.
EPD_GATEWAY_AUTH_MODE=disabled
EPD_AUTH_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EPD_AUTH_AUDIENCE=authenticated
# Optional: pin a client_id claim when your auth setup uses one.
EPD_AUTH_CLIENT_ID=

# Server-side canonical document repository.
# The gateway sends the verified USER JWT to Supabase Data API, so documents RLS remains authoritative.
# Use the public anon/publishable key here. NEVER use service_role for this path.
EPD_DATA_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EPD_DATA_SUPABASE_PUBLIC_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Optional persistent operator-attempt journal.
# Use a SEPARATE restricted PostgreSQL LOGIN that is a member of the NOLOGIN role
# `epd_gateway_writer`. Do not reuse EPD_DATABASE_URL/admin credentials here.
# When configured, completed sandbox attempts survive gateway restarts and duplicate
# GenerateTitleXml calls for the same document revision are blocked.
EPD_GATEWAY_DATABASE_URL=
EPD_GATEWAY_DATABASE_ROLE=epd_gateway_writer
EPD_OPERATOR_ATTEMPT_STALE_MS=300000

# Payment backend is intentionally disabled until a provider is selected and verified.
EPD_BILLING_PROVIDER=none
# Future verified-webhook processing uses ANOTHER restricted PostgreSQL LOGIN that is a member
# of NOLOGIN role `epd_billing_writer`. It must differ from both admin and operator gateway logins.
EPD_BILLING_DATABASE_URL=
EPD_BILLING_DATABASE_ROLE=epd_billing_writer

# In-memory gateway rate limits. They are applied before request bodies are parsed.
EPD_RATE_LIMIT_WINDOW_MS=60000
EPD_RATE_LIMIT_MAX=60
EPD_AUTH_ATTEMPT_LIMIT_MAX=120
# Stricter per-user limit for endpoints that actually call an operator API.
EPD_EXTERNAL_RATE_LIMIT_MAX=10

# Private Kontur/Diadoc server-side sandbox credentials.
# They are not required for local UserDataXml preview and never enable /send.
EPD_KONTUR_BOX_ID=
EPD_KONTUR_ACCESS_TOKEN=

# PostgreSQL encrypted backup / migration administration configuration.
# This credential may have broader schema rights and MUST NOT be reused by gateway/billing runtime.
# Keep this URL and passphrase only in the server secret environment; never put them in VITE_* or Git.
EPD_DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DB_NAME
EPD_BACKUP_DIR=.backups
EPD_BACKUP_RETENTION_DAYS=14
EPD_BACKUP_PASSPHRASE=
EPD_POSTGRES_CLIENT_IMAGE=postgres:17-alpine

# Restore drill uses a SEPARATE disposable database only.
# The restore script refuses the production URL and requires the test DB name to contain test/restore/staging.
EPD_RESTORE_TEST_DATABASE_URL=
# Set only for the explicit restore drill command:
# EPD_RESTORE_TEST_CONFIRM=RESTORE_TEST_ONLY

# Production baseline example:
# EPD_DEPLOYMENT_MODE=production
# EPD_OPERATOR_PROVIDER=none
# EPD_OPERATOR_MODE=disabled
# EPD_GATEWAY_AUTH_MODE=supabase
# EPD_BILLING_PROVIDER=none

# To intentionally enable ONLY sandbox GenerateTitleXml after all values above are configured:
# EPD_DEPLOYMENT_MODE=production
# EPD_OPERATOR_PROVIDER=kontur
# EPD_OPERATOR_MODE=sandbox
# EPD_GATEWAY_AUTH_MODE=supabase
# The sandbox route accepts only {"documentId":"<uuid>"}; it reloads the canonical document
# through Supabase RLS, calls GenerateTitleXml, and does NOT sign or call PostMessage.

# Do NOT put operator API tokens, billing/database credentials, backup passphrases, private keys,
# KEP material, Supabase service_role, or any other server secret into VITE_* variables.
# Provider/database secrets belong only to the private backend/server secret store/env.
